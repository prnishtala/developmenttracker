# Public — safe to ship in the app bundle (Supabase anon key is row-level-security protected)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only — set as Supabase Edge Function secrets, NEVER in the app.
#   supabase secrets set OPENAI_API_KEY=sk-...
OPENAI_API_KEY=optional_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
# Used only by scripts/push-seed.ts to load the seed into Supabase:
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
