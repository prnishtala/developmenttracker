UID:0b62fb1f-08ca-4d95-a54f-8b870cd4c394@family-os
DTSTAMP:20260707T120000Z
DTSTART;TZID=America/Chicago:20260706T121500
DTEND;TZID=America/Chicago:20260706T123500
RRULE:INTERVAL=2;FREQ=WEEKLY;BYDAY=MO,TU,WE,TH
SUMMARY:Lunch + midday BP pill — Bowl A (rice + dal)
DESCRIPTION:THIS WEEK'S BOWL: 1 cup rice (from Sunday's batch) + 3/4 cup da
 l (from Sunday's batch\, reheated) + 1/2 cup roasted vegetable (Sunday's a
 ir-fryer tray) + 2 tbsp yogurt + a spoon of pickle. Microwave rice+dal 90 
 sec\, plate\, add the rest cold. 3 minutes total.\n\nTake the midday BP pi
 ll from the kitchen-table organizer WITH the food — non-negotiable\, ski
 p the rest of the day before you skip this.
END:VEVENT
BEGIN:VEVENT
UID:c7fee3e6-91de-4eab-a075-7816c7ce9b67@family-os
