DTEND;TZID=America/Chicago:20260712T154500
RRULE:FREQ=WEEKLY;BYDAY=SU
SUMMARY:Sunday midday — open
DESCRIPTION:Open block. Non-Costco weeks this starts at 10:00 instead.
END:VEVENT
BEGIN:VEVENT
