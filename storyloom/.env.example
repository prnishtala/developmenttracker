# StoryLoom configuration. Copy to .env and fill in. NEVER commit real keys.

# --- Providers ---------------------------------------------------------------
# LLM: "offline" (deterministic template, no network) or "anthropic".
STORYLOOM_LLM_PROVIDER=offline
STORYLOOM_ANTHROPIC_API_KEY=
STORYLOOM_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# TTS: "offline" (tone/noise, no network), "elevenlabs", or "openai".
STORYLOOM_TTS_PROVIDER=offline
STORYLOOM_ELEVENLABS_API_KEY=
STORYLOOM_ELEVENLABS_MODEL=eleven_multilingual_v2
STORYLOOM_OPENAI_API_KEY=
STORYLOOM_OPENAI_TTS_MODEL=tts-1-hd

# --- Audio / mastering -------------------------------------------------------
# Optional path to a licensed music bed (wav/mp3). If unset, a soft synthetic bed is generated.
# Do NOT point this at unlicensed audio — this is a children's brand (SPEC §6).
STORYLOOM_MUSIC_BED_PATH=
STORYLOOM_TARGET_LUFS=-16.0
STORYLOOM_TARGET_TRUE_PEAK=-1.0
STORYLOOM_MP3_BITRATE=112k
# Leave blank to auto-resolve (system ffmpeg, else the bundled imageio-ffmpeg binary).
STORYLOOM_FFMPEG_BIN=

# --- Infrastructure (unused in M1) -------------------------------------------
STORYLOOM_DATABASE_URL=postgresql+psycopg://storyloom:storyloom@localhost:5432/storyloom
STORYLOOM_REDIS_URL=redis://localhost:6379/0
STORYLOOM_S3_ENDPOINT_URL=http://localhost:9000
STORYLOOM_S3_ACCESS_KEY=storyloom
STORYLOOM_S3_SECRET_KEY=storyloom123
STORYLOOM_S3_BUCKET=storyloom-audio

# Output directory for the CLI run store.
STORYLOOM_OUT_DIR=./out
